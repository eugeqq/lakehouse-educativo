{
  "datasets": [
    {
      "name": "d0c5b080",
      "displayName": "kpis_calidad",
      "queryLines": [
        "SELECT tabla, dimension, valor, umbral_optimo, estado \r\n",
        "FROM main.edu_lakehouse.gold_kpis_calidad"
      ]
    },
    {
      "name": "fb4aac4a",
      "displayName": "resumen_alumnos_riesgo",
      "queryLines": [
        "SELECT nombre, carrera, promedio_nota, pct_asistencia, riesgo,\r\n",
        "       CASE \r\n",
        "         WHEN nombre = 'Ana Ruiz' THEN 'Caso Urgente: Promedio bajo y ausencia total'\r\n",
        "         WHEN pct_asistencia < 60 THEN 'Asistencia por debajo del umbral mínimo'\r\n",
        "         WHEN riesgo = 'SIN NOTA' THEN 'Nota pendiente de carga o Ausente'\r\n",
        "         ELSE 'Regularizado'\r\n",
        "       END as accion_pedagogica\r\n",
        "FROM main.edu_lakehouse.gold_riesgo_alumnos"
      ]
    },
    {
      "name": "893de5ff",
      "displayName": "rendimiento_materias",
      "queryLines": [
        "SELECT nombre, promedio_nota, cantidad_examenes,\r\n",
        "       CASE WHEN promedio_nota < 6 THEN 'Requiere Atención Pedagógica' ELSE 'Desempeño Normal' END as estatus_materia\r\n",
        "FROM main.edu_lakehouse.gold_promedio_materia"
      ]
    },
    {
      "name": "a018a977",
      "displayName": "auditoria_cuarentena",
      "queryLines": [
        "SELECT 'Alumnos' as entidad, count(*) as rechazados FROM main.edu_quarantine.cuarentena_alumnos UNION ALL\r\n",
        "SELECT 'Notas' as entidad, count(*) as rechazados FROM main.edu_quarantine.cuarentena_notas UNION ALL\r\n",
        "SELECT 'Asistencia' as entidad, count(*) as rechazados FROM main.edu_quarantine.cuarentena_asistencia UNION ALL\r\n",
        "SELECT 'Integridad Referencial' as entidad, count(*) as rechazados FROM main.edu_quarantine.cuarentena_integridad_referencial"
      ]
    }
  ],
