{
  "datasets": [
    {
      "name": "893de5ff",
      "displayName": "rendimiento_materias",
      "queryLines": [
        "SELECT\n",
        "  nombre,\n",
        "  promedio_nota,\n",
        "  cantidad_examenes,\n",
        "  CASE\n",
        "    WHEN promedio_nota < 6 THEN 'Requiere Atención Pedagógica'\n",
        "    ELSE 'Desempeño Normal'\n",
        "  END as estatus_materia\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_promedio_materia"
      ]
    },
    {
      "name": "d0c5b080",
      "displayName": "kpis_calidad",
      "queryLines": [
        "SELECT\n",
        "  tabla,\n",
        "  dimension,\n",
        "  valor,\n",
        "  umbral_optimo,\n",
        "  estado\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_kpis_calidad"
      ]
    },
    {
      "name": "resumen_ejecutivo",
      "displayName": "resumen_ejecutivo",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) total_alumnos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN riesgo = 'EN RIESGO' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) alumnos_riesgo,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN riesgo = 'EN RIESGO' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) pct_riesgo,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN riesgo = 'SIN NOTA' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) alumnos_sin_nota,\n",
        "  ROUND(AVG(promedio_nota), 2) promedio_general,\n",
        "  ROUND(AVG(pct_asistencia), 1) asistencia_promedio\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_riesgo_alumnos"
      ]
    },
    {
      "name": "calidad_global",
      "displayName": "calidad_global_datos",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN estado = 'OPTIMO' THEN 100\n",
        "        WHEN estado = 'ALERTA' THEN 50\n",
        "        ELSE 0\n",
        "      END\n",
        "    ),\n",
        "    1\n",
        "  ) as score_calidad,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN estado = 'CRITICO' THEN 1\n",
        "    END\n",
        "  ) as total_criticos\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_kpis_calidad"
      ]
    },
    {
      "name": "alumnos_priorizados",
      "displayName": "alumnos_alta_prioridad",
      "queryLines": [
        "SELECT\n",
        "  nombre,\n",
        "  carrera,\n",
        "  promedio_nota,\n",
        "  pct_asistencia,\n",
        "  riesgo,\n",
        "  CASE\n",
        "    WHEN pct_asistencia < 60 AND promedio_nota < 4 THEN 'Caso Urgente: Promedio bajo y ausencia total'\n",
        "    WHEN pct_asistencia < 60 THEN 'Asistencia por debajo del umbral mínimo'\n",
        "    WHEN promedio_nota < 4 THEN 'Promedio por debajo del umbral mínimo'\n",
        "    ELSE 'Regularizado'\n",
        "  END as accion_pedagogica,\n",
        "  CASE\n",
        "    WHEN\n",
        "      promedio_nota < 4\n",
        "      AND pct_asistencia < 50\n",
        "    THEN\n",
        "      3\n",
        "    WHEN\n",
        "      promedio_nota < 5\n",
        "      OR pct_asistencia < 50\n",
        "    THEN\n",
        "      2\n",
        "    WHEN riesgo = 'SIN NOTA' THEN 1\n",
        "    ELSE 0\n",
        "  END as nivel_severidad,\n",
        "  CASE\n",
        "    WHEN\n",
        "      promedio_nota < 4\n",
        "      AND pct_asistencia < 50\n",
        "    THEN\n",
        "      '🔴🔴🔴 URGENTE'\n",
        "    WHEN\n",
        "      promedio_nota < 5\n",
        "      OR pct_asistencia < 50\n",
        "    THEN\n",
        "      '🔴🔴 ALTO'\n",
        "    WHEN riesgo = 'SIN NOTA' THEN '🟡 MEDIO'\n",
        "    ELSE '🟢 BAJO'\n",
        "  END as prioridad\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_riesgo_alumnos\n",
        "WHERE\n",
        "  riesgo IN ('EN RIESGO', 'SIN NOTA')\n",
        "ORDER BY\n",
        "  nivel_severidad DESC,\n",
        "  promedio_nota ASC"
      ]
    },
    {
      "name": "riesgo_por_carrera",
      "displayName": "riesgo_por_carrera",
      "queryLines": [
        "SELECT\n",
        "  carrera,\n",
        "  COUNT(*) as total_alumnos,\n",
        "  COUNT(\n",
        "    CASE\n",
        "      WHEN riesgo = 'EN RIESGO' THEN 1\n",
        "    END\n",
        "  ) as alumnos_riesgo,\n",
        "  ROUND(\n",
        "    COUNT(\n",
        "      CASE\n",
        "        WHEN riesgo = 'EN RIESGO' THEN 1\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) as pct_riesgo\n",
        "FROM\n",
        "  main.edu_lakehouse.gold_riesgo_alumnos\n",
        "GROUP BY\n",
        "  carrera\n",
        "ORDER BY\n",
        "  pct_riesgo DESC"
      ]
    }
  ],
